<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:padding="@dimen/screen_padding">

    <!-- Page title -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/customerlist_title"
        android:textColor="@color/black"
        android:textSize="@dimen/title_text_size"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- Customer count / status -->

    <TextView
        android:id="@+id/customerSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/customer_loading"
        android:textColor="@color/secondary_text"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- Customers -->

    <ListView
        android:id="@+id/customerListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:divider="@color/input_border"
        android:dividerHeight="1dp"
        android:padding="@dimen/input_padding"
        android:clipToPadding="false" />

    <!-- Add customer -->

    <Button
        android:id="@+id/addCustomerButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/add_customer_button"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/primary_button"
        android:layout_marginTop="@dimen/spacing_medium" />

    <!-- Refresh -->

    <Button
        android:id="@+id/refreshCustomersButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/refresh_customers"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:background="@drawable/secondary_button"
        android:layout_marginTop="@dimen/spacing_small" />

    <!-- Back to dashboard -->

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/back_to_dashboard"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:background="@drawable/secondary_button"
        android:layout_marginTop="@dimen/spacing_small" />

</LinearLayout>
